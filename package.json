{
  "name": "pvcon-holiday-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "DB_FILE=./data/demo.db UPLOAD_DIR=./data/demo-uploads SMTP_HOST= next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/people.db data/people.db-wal data/people.db-shm && npm run db:migrate && npm run db:seed",
    "db:demo": "DB_FILE=./data/demo.db UPLOAD_DIR=./data/demo-uploads tsx --import ./scripts/_react-pdf-hooks.mjs scripts/demo.ts",
    "db:migrate-legacy": "tsx scripts/migrate-legacy.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@signpdf/utils": "3.3.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.11.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.16",
    "papaparse": "^5.7.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
